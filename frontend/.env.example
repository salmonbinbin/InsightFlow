# InsightFlow frontend configuration (Phase 7 — work package A)
# Copy this file to `.env.local` (which is git-ignored) and adjust values as
# required. NEXT_PUBLIC_* variables are exposed to the browser bundle.

# Base URL of the InsightFlow FastAPI backend. This value is consumed ONLY
# by the Next.js rewrite in next.config.mjs to forward same-origin `/api/*`
# requests to the backend. It is NOT read by the browser-side API client —
# the browser always hits the same-origin `/api/...` path so that the
# backend's missing CORS configuration is bypassed by the Next.js proxy.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
