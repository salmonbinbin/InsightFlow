# PostgreSQL connection used by alembic, dev runner and API.
DATABASE_URL=postgresql+psycopg://insightflow:insightflow_local@localhost:5433/insightflow

# Phase 1 AI Classification — values must come from environment only.
# Do NOT commit real keys. The application reads these at runtime;
# missing values disable real classification and surface a clear error.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
CLASSIFICATION_BATCH_SIZE=20
CLASSIFICATION_MAX_RETRIES=2
CLASSIFICATION_PROMPT_VERSION=feedback-classification-v1

# Phase 2 Embedding + Clustering.
# ``embedding_model`` is the canonical name persisted on every vector so
# rows produced by different models are never compared. ``embedding_dimension``
# is checked against the actual vector length by PostgreSQL and Python.

# local-hash-v1 is a deterministic test backend, NOT a semantic model.
# Remote provider base URL excludes /v1; endpoint is /v1/embeddings.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSION=128
EMBEDDING_MAX_RETRIES=2
EMBEDDING_MAX_BATCH_SIZE=64
# Cosine-distance threshold for agglomerative clustering. Lower values
# produce smaller/more clusters; higher values permit more merges.
# Cosine distance = 1 - cosine similarity; merge only when distance < threshold.
CLUSTER_DISTANCE_THRESHOLD=0.45
# average | complete | single
CLUSTER_LINKAGE=average
# Set to 0 to skip the LLM semantic review entirely.
CLUSTER_REVIEW_ENABLED=1
CLUSTER_REVIEW_MAX_RETRIES=2

# Phase 8 Research. Local configuration only; these keys are intentionally blank.
# Legacy default stays tavily. The current frontend requests research-agent-v7.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=30
TAVILY_MAX_RESULTS=5
TAVILY_MAX_RETRIES=2
RESEARCH_SEARCH_PROVIDER=tavily
# Optional: tavily or minimax; omit/leave commented when no fallback is intended.
# RESEARCH_SEARCH_FALLBACK=minimax
MINIMAX_SEARCH_API_KEY=
MINIMAX_SEARCH_BASE_URL=https://api.minimaxi.com
# LLM credentials are separate; the app does not read desktop MCP secrets.
